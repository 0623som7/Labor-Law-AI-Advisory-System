# 复制成 .env 后按需修改：cp .env.example .env
# .env 已在 .gitignore 里，任何真实密钥都不许提交。

# ---- 进程 ----
APP_ENV=dev
APP_NAME=laborlaw-api
APP_VERSION=dev
# 启动时自动执行未应用的迁移。生产环境被 config 强制禁止。
AUTO_MIGRATE=true

# ---- HTTP ----
# 监听地址；2 核机器上不需要多实例，一个端口即可。
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
# 0 表示不限：SSE 长连接不能被写超时掐断，收敛交给 handler 的 ctx。
HTTP_WRITE_TIMEOUT=0s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=12582912
# 只有这些代理转发来的 X-Forwarded-For 才被采信。不配或留空表示谁都不信，
# ClientIP() 退回 TCP 层 RemoteAddr——反过来（信任所有来源）等于把限流键
# 交给客户端自己填，一个头就能绕过。
#
# 172.16.0.0/12 只覆盖 Docker 网段（默认 bridge 172.17.0.0/16、compose 自定义
# 网络 172.18.0.0/16 都在里面）。不加这一段，nginx 反代过来的请求来源是网关
# 地址 172.17.0.1，所有用户会共用 auth:login:172.17.0.1 一个限流桶——一个人
# 连错 5 次密码，全场 429。
# 敢信任整段 Docker 网段的前提：api 不对外发布端口（compose 里已收成
# 127.0.0.1:8080:8080），外部没有路径伪造 X-Forwarded-For。
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# ---- 认证 ----
# 至少 32 字节；生产环境用 openssl rand -hex 32 生成。
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ISSUER=laborlaw
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=720h
# 仅本地开发：非空时跳过鉴权、以该身份处理请求。
# production 下 config.Validate 会拒绝它。
AUTH_DEV_USER=dev-user-0001
AUTH_LOGIN_RATE_LIMIT=5

# ---- MySQL ----
# 密码写在这里，永不入库、永不进日志。
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/laborlaw?parseTime=true&charset=utf8mb4&loc=UTC
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=5
MYSQL_CONN_MAX_LIFETIME=30m

# ---- Redis ----
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_DIAL_TIMEOUT=2s

# ---- LLM 网关 ----
# key 由 Agent 侧填写，绝不提交。
# DashScope（阿里云百炼）。本项目实测可用的就是这一家：支持 response_format json_schema，
# 国内直连。换平台要同时改模型名并确认对方支持 json_schema（DeepSeek 只支持 json_object）。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# 演示与日常用 qwen-plus（首字约 0.5s）。需要更强推理时改回 qwen3.8-max（首字 18-37s，现场演示不要用）。
LLM_MODEL_CONSULT=qwen-plus
# 抽取必须走快速档：一次审查只有一条 120 秒的任务预算，抽取是其中最长的一步。
# 用强档（qwen3.8-max）实测单次 60 秒超时、重试一次就把任务预算烧光，任务被判超时。
# 换网关时同样挑"支持 response_format=json_schema 的快速档"，实测过再填。
LLM_MODEL_EXTRACT=qwen3-coder-flash
# 演示与日常用 qwen-plus（首字约 0.5s）。需要更强推理时改回 qwen3.8-max（首字 18-37s，现场演示不要用）。
LLM_MODEL_ADVISE=qwen-plus
# 向量化模型。换它必须整体重建 embeddings（owner_type=statute 的行按新 model 重写），
# 不同模型的向量空间互不相通，混着算余弦排出来的名次没有意义。
LLM_EMBEDDING_MODEL=text-embedding-v3
# LLM_TIMEOUT 是"单次往返"上限，非流式调用用它。
LLM_TIMEOUT=60s
# LLM_STREAM_TIMEOUT 是流式生成的整体上限：SSE 是一条持续吐字的长连接，
# 耗时随回答长度增长（实测三轮咨询 35.6s / 44.2s / 51.7s），拿 60s 当上限
# 会在长回答中途整段掐断，而"已吐过字就不再重试"，用户直接丢掉这次回答。
# 必须 >= LLM_TIMEOUT。
LLM_STREAM_TIMEOUT=300s
LLM_MAX_RETRIES=2
# 首次重试前的等待，之后翻倍；本地打假上游时可设 0。
LLM_RETRY_BACKOFF=300ms
# 每千 token 单价（元），用于成本估算与日预算闸。
LLM_PRICE_INPUT_PER_1K=0.001
LLM_PRICE_OUTPUT_PER_1K=0.002
LLM_QPS=5
LLM_DAILY_BUDGET_YUAN=20
# 单次请求的上下文上限（token 估算用汉字数近似），qwen-plus 是 131072。
# 只决定带多少历史：调大不会更贵，只会让长会话保留更多上下文。
LLM_CONTEXT_TOKENS=8000
LLM_RERANK_MODEL=qwen3-rerank
# 重排端点走 DashScope 原生 API（不是 /compatible-mode）。若经典地址不可用，
# 改用带业务空间 ID 的地址即可，不用改代码。gte-rerank-v2 于 2026-05-30 下线，别用。
LLM_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# 重排超时。默认 8s 覆盖冷启动 TLS 握手（实测 2.4s）的余量；
# 超时后自动退回融合顺序，不影响回答。
LLM_RERANK_TIMEOUT=8s

# ---- 存储 ----
STORAGE_ROOT=./storage
STORAGE_MAX_UPLOAD_MB=5
STORAGE_MAX_PAGES=50

# ---- worker ----
WORKER_POOL_SIZE=2
# 单任务超时。合同要素抽取实测 50–110s，撞上上游 50301 时会再重试一次，
# 120s 会在第一次重试途中把 ctx 掐掉（任务卡在 running 直到进程重启）。
# 300s 留出一次重试的余量；再放宽只是让失败更晚被发现，不是更好。
WORKER_TASK_TIMEOUT=300s
WORKER_QUEUE_SIZE=100

# ---- PDF 解析 ----
FILE_MIN_CONFIDENCE=0.6
FILE_MAX_BLOCKS_PER_PAGE=500
# pdftotext 可执行文件；默认走 PATH。Windows 用 winget 装完 poppler 后通常不在 PATH 里，
# 需要填绝对路径（如 ...\poppler-25.07.0\Library\bin\pdftotext.exe）。
FILE_PDFTOTEXT_PATH=pdftotext
FILE_EXTRACT_TIMEOUT=30s

# ---- 检索 ----
# 咨询链路是否叠加向量召回（关键词 + 向量的 RRF 融合）。
# 开启前必须跑过 cmd/embeddingseed 把 statutes 灌进 embeddings，否则索引为空、
# 每次问答白多一次向量化往返（会降级，但纯属浪费）。
# 语义这一侧任何失败都自动退回关键词检索，不影响 /chat/completions 成功。
RETRIEVAL_SEMANTIC=off
# 打开交叉编码器重排：命中率会涨，但每次问答多一次 1.8~2.4s 的请求。
RETRIEVAL_RERANK=false

# ---- 日志 ----
LOG_LEVEL=info
LOG_FORMAT=text
