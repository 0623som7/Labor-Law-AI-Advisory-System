# 复制成 .env 后按需修改：cp .env.example .env
# .env 已在 .gitignore 里，任何真实密钥都不许提交。

# ---- 进程 ----
APP_ENV=dev
APP_NAME=laborlaw-api
APP_VERSION=dev

# ---- HTTP ----
# 监听地址；2 核机器上不需要多实例，一个端口即可。
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
# 0 表示不限：SSE 长连接不能被写超时掐断，收敛交给 handler 的 ctx。
HTTP_WRITE_TIMEOUT=0s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=12582912

# ---- 认证 ----
# 至少 32 字节；生产环境用 openssl rand -hex 32 生成。
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ISSUER=laborlaw
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=720h
# 仅本地开发：非空时跳过鉴权、以该身份处理请求。
# production 下 config.Validate 会拒绝它。
AUTH_DEV_USER=dev-user-0001
AUTH_LOGIN_RATE_LIMIT=5

# ---- MySQL ----
# 密码写在这里，永不入库、永不进日志。
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/laborlaw?parseTime=true&charset=utf8mb4&loc=UTC
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=5
MYSQL_CONN_MAX_LIFETIME=30m

# ---- Redis ----
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_DIAL_TIMEOUT=2s

# ---- LLM 网关 ----
# key 由 Agent 侧填写，绝不提交。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_CONSULT=deepseek-chat
LLM_MODEL_EXTRACT=deepseek-chat
LLM_MODEL_ADVISE=deepseek-chat
LLM_TIMEOUT=60s
LLM_MAX_RETRIES=2
LLM_QPS=5
LLM_DAILY_BUDGET_YUAN=20

# ---- 存储 ----
STORAGE_ROOT=./storage
STORAGE_MAX_UPLOAD_MB=5
STORAGE_MAX_PAGES=50

# ---- worker ----
WORKER_POOL_SIZE=2
WORKER_TASK_TIMEOUT=120s
WORKER_QUEUE_SIZE=100

# ---- PDF 解析 ----
FILE_MIN_CONFIDENCE=0.6
FILE_MAX_BLOCKS_PER_PAGE=500

# ---- 日志 ----
LOG_LEVEL=info
LOG_FORMAT=text
