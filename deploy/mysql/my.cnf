# innodb_buffer_pool_size 按机型设定：4G 机型 512M、2G 机型 256M。
# 本项目法条表 205 条约 150KB，pool 再大没有收益；真正的内存大头是
# performance_schema，本文件已关闭它。
# 降到 2G 机型时：本值改 256M，compose 里 mysql 的 memory 限额同步改 640M。
#
# ⚠ 本文件不是 bind mount，而是由 deploy/mysql/Dockerfile COPY 进镜像并 chmod 644。
#   MySQL 会静默忽略 world-writable 的配置文件（只打一条 Warning），
#   而 Windows 上 bind mount 一律 0777、compose configs 在 standalone 模式下
#   也不改权限 —— 两者实测都没生效过。改回挂载前先跑 runbook 3.4.2 的验证。
#
# innodb_flush_log_at_trx_commit=2 是有代价的：断电可能丢最后 1 秒事务。
# 答辩与演示场景可接受，写进 runbook 的已知取舍；真上生产要改回 1。
[mysqld]
innodb_buffer_pool_size         = 512M
innodb_log_file_size            = 64M
innodb_flush_method             = O_DIRECT
innodb_flush_log_at_trx_commit  = 2
max_connections                 = 50
performance_schema              = OFF
table_open_cache                = 200
skip_name_resolve               = ON
character_set_server            = utf8mb4
collation_server                = utf8mb4_0900_ai_ci

# ngram 全文索引的分词长度：2 是中英文混合场景的常用值，
# 太短会把"工资"拆成"工""资"，太长会漏掉"社保"这类两字词。
ngram_token_size = 2

# 时间一律存 UTC，由应用层转换；这里固定时区避免服务器时区漂移影响 DATETIME 默认值。
default-time-zone = '+00:00'
