# 2G 机器上的 MySQL 参数。默认配置会吃掉 700MB+，必须压。
#
# 其中 innodb_flush_log_at_trx_commit=2 是有代价的：断电可能丢最后 1 秒事务。
# 答辩与演示场景可接受，写进 runbook 的已知取舍；真上生产要改回 1。
[mysqld]
innodb_buffer_pool_size         = 256M
innodb_log_file_size            = 64M
innodb_flush_method             = O_DIRECT
innodb_flush_log_at_trx_commit  = 2
max_connections                 = 50
performance_schema              = OFF
table_open_cache                = 200
skip_name_resolve               = ON
character_set_server            = utf8mb4
collation_server                = utf8mb4_0900_ai_ci

# ngram 全文索引的分词长度：2 是中英文混合场景的常用值，
# 太短会把"工资"拆成"工""资"，太长会漏掉"社保"这类两字词。
ngram_token_size = 2

# 时间一律存 UTC，由应用层转换；这里固定时区避免服务器时区漂移影响 DATETIME 默认值。
default-time-zone = '+00:00'
